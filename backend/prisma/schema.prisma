generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?  @db.VarChar(255)
  cpf       String?  @db.VarChar(14) // login do aluno(a)
  unit      String?
  tags      String   @default("[]") @db.VarChar(1000) // JSON array de etiquetas
  notes     String?  @db.Text
  pin       String?  @db.VarChar(255) // bcrypt hash do PIN de 4 dígitos; null = sem PIN cadastrado
  birthday  String?  @db.VarChar(10) // 'YYYY-MM-DD'
  level     String?  @db.VarChar(20) // Iniciante | Intermediário | Avançado
  firstClass Boolean @default(false) // aluna nova / ainda na primeira aula
  // ----- plano / cobrança -----
  plan         String  @default("avulso") @db.VarChar(20) // "avulso" | "mensalista"
  status       String  @default("ativo") @db.VarChar(20) // "ativo" | "cancelado" (rompeu com o curso)
  weeklyFreq   Int?    // aulas por semana do mensalista: 1 (R$120) ou 2 (R$200); null = plano antigo
  // Como a mensalista ocupa a agenda:
  //   "fixo"   → dia e hora fixos, agendados em lote pela Inêz
  //   "escala" → ela mesma marca, e só no dia em que tem aula
  mensalistaTipo String @default("fixo") @db.VarChar(10)
  // Direitos herdados: sábado e horários a partir das 18:00 saíram do plano,
  // mas quem JÁ estava nesses horários continua podendo. Preenchidos uma única
  // vez pela migration 20260822000000 — a regra é travada, não se edita na ficha.
  podeSabado   Boolean @default(false)
  podeNoite    Boolean @default(false)
  /* Troca de plano: `weeklyFreq` já guarda o plano NOVO (é o que a ficha mostra
     e o que vale daqui pra frente), e estes dois dizem de quando ele vale. Aula
     em data anterior a `weeklyFreqDesde` ainda é medida pelo teto antigo — sem
     isso, subir de 1x para 2x no dia 30 abriria uma vaga extra na semana que
     está acabando, num mês que já foi cobrado pelo plano velho. */
  weeklyFreqAnterior Int?    // plano de antes da troca
  weeklyFreqDesde    String? @db.VarChar(7) // 'YYYY-MM' a partir da qual o novo vale
  monthlyValue Float?  // valor individual da mensalidade; null = usa o valor do plano
  billingDay   Int?    // dia de vencimento (1-28); null = usa o padrão
  // ----- taxa de matrícula (cobrada uma vez, na 1ª aula) -----
  // "nao_aplica" (nunca se matriculou) | "pendente" | "paga" | "convertida" | "devolvida"
  matriculaStatus String  @default("nao_aplica") @db.VarChar(20)
  matriculaAt     String? @db.VarChar(10) // quando a taxa foi paga
  matriculaRefundAt String? @db.VarChar(10) // quando a taxa foi devolvida
  trialDate       String? @db.VarChar(10) // data da 1ª aula (nome herdado do fluxo antigo)
  /* De onde veio a ficha. Interessa na tela: o cadastro feito pela conversa do
     WhatsApp é digitado pela própria aluna, sem ninguém conferindo do outro
     lado, então o painel mostra "Cadastro via WhatsApp" para a Inêz saber que
     aquele nome, e-mail e data de nascimento vieram de lá.
     null = cadastro antigo ou feito no painel. */
  origem   String? @db.VarChar(20) // "whatsapp" | "portal" | "site"
  aniversarioMsgAt String? @db.VarChar(10) // 'YYYY-MM-DD' quando a última mensagem de parabéns foi enviada
  makeupCredits Int    @default(0) // LEGADO: não usado — o saldo real vem da tabela MakeupCredit
  createdAt DateTime @default(now())
  invoices  Invoice[]
  makeups   MakeupCredit[]
  extras    ExtraPass[]
  precos    MonthlyPrice[]
}

// Valor da mensalidade combinado para UM mês específico — desconto pontual,
// promoção de 2/3 meses, cortesia. É o que permite mexer no valor de um mês sem
// mexer no valor recorrente da aluna (Client.monthlyValue): passada a
// competência, a mensalidade volta sozinha ao valor de sempre.
//
// Precedência do valor de uma competência:
//   MonthlyPrice da competência → Client.monthlyValue → plano 1x/2x → legado
model MonthlyPrice {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  competencia String   @db.VarChar(7) // 'YYYY-MM'
  amountCents Int
  // De onde veio: "desconto" | "promocao" | "reajuste" | "ajuste"
  origem      String   @default("ajuste") @db.VarChar(20)
  motivo      String?  @db.VarChar(200) // o porquê, escrito pela Inêz — aparece na ficha
  createdAt   DateTime @default(now())

  @@unique([clientId, competencia])
  @@index([competencia])
}

// Aula extra comprada pela aluna no portal: ela paga o Pix primeiro e só depois
// escolhe o horário. O passe é o comprovante dessa compra — nasce "pendente",
// vira "pago" quando o Sicredi confirma e "usado" quando vira aula.
// Não gera crédito de reposição e não é devolvido (avisado na tela da compra).
model ExtraPass {
  id            Int      @id @default(autoincrement())
  clientId      Int
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amountCents   Int      // valor congelado na hora da compra, não segue mudanças de tabela
  status        String   @default("pendente") @db.VarChar(20) // pendente | pago | usado | cancelado
  txid          String?  @db.VarChar(40) // cobrança Pix no Sicredi (padrão BACEN)
  pixCode       String?  @db.Text
  paidAt        String?  @db.VarChar(10)
  usedBookingId Int? // aula marcada com este passe (sem FK: a aula pode ser excluída)
  usedAt        String?  @db.VarChar(10)
  createdAt     DateTime @default(now())

  @@index([clientId])
  @@index([txid])
}

// Créditos de reposição do mensalista.
// Um crédito nasce quando a aluna libera uma aula com a antecedência mínima
// (ver regrasReposicao no server) e morre no fim do mês seguinte ao da aula liberada.
model MakeupCredit {
  id              Int      @id @default(autoincrement())
  clientId        Int
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  competencia     String   @db.VarChar(7) // mês da aula liberada, 'YYYY-MM' — o teto de 2 é por competência
  expiresOn       String   @db.VarChar(10) // último dia do mês seguinte, 'YYYY-MM-DD'
  originBookingId Int? // aula liberada que gerou o crédito (sem FK: a aula pode ser excluída)
  originDate      String   @db.VarChar(10)
  originTime      String   @db.VarChar(5)
  usedBookingId   Int? // aula de reposição marcada com este crédito
  usedAt          String?  @db.VarChar(10)
  createdAt       DateTime @default(now())

  @@index([clientId])
  @@index([competencia])
  @@index([usedBookingId])
}

// Mensalidades (boletos) dos alunos mensalistas
model Invoice {
  id            Int      @id @default(autoincrement())
  clientId      Int
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  competencia   String   @db.VarChar(7) // mês de referência 'YYYY-MM'
  amountCents   Int      // valor ORIGINAL em centavos (nunca muda; multa e juros entram por fora)
  dueDate       String   @db.VarChar(10) // 'YYYY-MM-DD'
  status        String   @default("pendente") @db.VarChar(20) // pendente | pago | cancelado
  txid          String?  @db.VarChar(40) // id da cobrança Pix no Sicredi (padrão BACEN)
  boletoUrl     String?  @db.VarChar(500) // legado da Cora; Pix puro não gera boleto
  pixCode       String?  @db.Text
  pixExpiresOn  String?  @db.VarChar(10) // até quando o pixCode é pagável, 'YYYY-MM-DD'
  // Data usada para calcular a multa e os juros embutidos no pixCode atual.
  // null = o QR foi emitido sem acréscimo (ainda estava em dia). É por ela que
  // se sabe quando o QR ficou desatualizado e precisa ser reemitido.
  encargosAte   String?  @db.VarChar(10)
  paidAt        String?  @db.VarChar(30)
  // Baixa dada na mão pela escola (dinheiro, transferência, acerto pessoal) em
  // vez de confirmada pelo Sicredi. Quem paga assim não usa o Pix, então a
  // mensalidade SEGUINTE nasce sem QR — ver `semPix` logo abaixo.
  baixaManual   Boolean  @default(false)
  // Esta mensalidade não emite Pix: nasceu depois de uma baixa manual. O portal
  // não oferece QR e a rodada automática não emite. O botão "Gerar Pix" do
  // painel limpa a marca — é a saída para quando a aluna pedir o código.
  semPix        Boolean  @default(false)
  /* Quando cada aviso automático de WhatsApp saiu ('YYYY-MM-DD'). São duas datas
     e não um booleano porque o que interessa é *quando* falamos com a aluna —
     e porque assim o reenvio acidental fica visível no banco. */
  avisoAVencerAt String? @db.VarChar(10) // lembrete amigável, 2 dias antes
  avisoAtrasoAt  String? @db.VarChar(10) // cobrança, 1 dia depois do vencimento
  createdAt     DateTime @default(now())

  @@index([clientId])
  @@index([competencia])
  @@index([txid])
}

model Slot {
  id        Int        @id @default(autoincrement())
  date      String // 'YYYY-MM-DD'
  time      String // 'HH:MM'
  unit      String
  prof      String?
  capacity  Int        @default(4)
  seriesId  String?    @db.VarChar(40) // horários criados juntos (replicação) compartilham o mesmo id
  createdAt DateTime   @default(now())
  bookings  Booking[]
  waitlist  Waitlist[]

  @@index([date])
  @@index([unit])
  @@index([seriesId])
}

model Booking {
  id            Int      @id @default(autoincrement())
  clientName    String
  phone         String?
  unit          String
  date          String
  time          String
  prof          String?
  slotId        Int
  slot          Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  seriesId      String?  @db.VarChar(40) // aulas marcadas juntas (replicação) compartilham o mesmo id
  status        String   @default("aguardando") // aguardando | confirmada | concluida | cancelada
  attendance    String   @default("") // '' | presente | falta
  absenceReason String   @default("") @db.VarChar(500) // motivo informado pelo aluno
  value         Float    @default(80)
  /* Quanto de TAXA DE MATRÍCULA está dentro de `value`. Só a reserva da aula
     de matrícula tem isto preenchido; null = reserva sem taxa (todas as antigas).

     Existe porque `value` é o que a aluna PAGA (mensalidade + taxa) e a
     mensalidade do mês tem que entrar no financeiro pelo valor dela, sem a
     taxa. Guardado na reserva, e não lido das Configurações na hora de somar:
     a Inêz pode mudar a taxa amanhã, e o que esta aluna pagou hoje não muda. */
  taxaMatricula Float?
  paid          Boolean  @default(false)
  paymentMethod String?
  paymentDate   String?
  txid          String?  @db.VarChar(40) // id da cobrança Pix no Sicredi (padrão BACEN)
  pixCode       String?  @db.Text // Pix copia-e-cola (EMV) devolvido pelo Sicredi
  boletoUrl     String?  @db.VarChar(500) // legado da Cora; Pix puro não gera boleto
  /* Reserva feita pelo WhatsApp e ainda não paga: a vaga fica SEGURADA até aqui
     (1 hora). Passou do prazo sem o Pix cair, a rodada libera a vaga — senão uma
     conversa abandonada tira a vaga de quem ia pagar. null = sem prazo. */
  holdUntil     DateTime?
  // Se o lembrete de meia hora antes do fim do prazo já foi enviado.
  holdNudged    Boolean  @default(false)
  /* Dia em que saiu o lembrete da véspera ('YYYY-MM-DD'). Guardar a data, e não
     um booleano, deixa claro no banco quando a escola falou com a aluna — e é o
     que impede o lembrete de sair duas vezes para a mesma aula. */
  lembreteAulaAt String? @db.VarChar(10)
  createdAt     DateTime @default(now())

  @@index([slotId])
  @@index([date])
  @@index([seriesId])
  @@index([txid])
  @@index([holdUntil])
}

model Waitlist {
  id        Int      @id @default(autoincrement())
  slotId    Int
  slot      Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  createdAt DateTime @default(now())

  @@index([slotId])
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String   @default("") @db.VarChar(255) // ex: "@instagram · Ipatinga/MG"
  text      String   @db.Text
  photo     String?  @db.VarChar(255) // nome do arquivo em /depoimentos/
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model WaConversation {
  phone     String   @id @db.VarChar(20) // wa_id normalizado
  // start|unit|slot|confirm|cpf|name|nameok|wpp|email|nasc|plano|cobranca|done
  step      String   @default("start") @db.VarChar(20)
  unit      String?  @db.VarChar(60)
  slotId    Int? // horário escolhido (aguardando confirmação/nome)
  offered   String   @default("[]") @db.VarChar(500) // JSON dos slotIds oferecidos
  pendingName String? @db.VarChar(120) // nome digitado, aguardando confirmação
  // Plano escolhido na conversa (1 ou 2 aulas por semana) — é o que define o
  // valor da 1ª mensalidade, que é o pagamento que matricula a aluna.
  weeklyFreq Int?
  // CPF do pagador: o Sicredi exige para emitir a cobrança Pix. É também a
  // CHAVE de entrada da conversa — antes de marcar, o bot pergunta o CPF e
  // procura a ficha; quem já existe não preenche cadastro de novo.
  cpf       String?  @db.VarChar(14)
  /* Demais dados do cadastro feito pelo WhatsApp, guardados enquanto a conversa
     acontece. Só viram ficha de aluna quando o conjunto está completo — meia
     ficha no painel é pior que nenhuma. */
  pendingEmail String? @db.VarChar(255)
  pendingBirthday String? @db.VarChar(10) // 'YYYY-MM-DD'
  pendingPhone String? @db.VarChar(20)    // WhatsApp confirmado (pode não ser o do chat)
  clientId  Int? // ficha encontrada pelo CPF ou criada pela conversa
  // Reserva provisória criada por esta conversa, aguardando o Pix.
  bookingId Int?
  /* Quantas vezes ela pediu para falar com uma pessoa. O número do atendente só
     sai na 3ª — antes disso o bot mostra o que resolve na hora. Zera junto com
     a conversa. */
  humanoPedidos Int @default(0)
  /* Última mensagem RECEBIDA dela. É por este relógio que a conversa expira:
     passadas 12h em silêncio, o próximo "oi" começa do zero, sem herdar
     horário, plano nem cadastro pela metade de ontem. `updatedAt` não serve
     para isso porque também mexe quando é o BOT que escreve. */
  lastInboundAt DateTime?
  /* Quando o bot cutucou uma conversa parada no meio. Fica preenchido até a
     aluna responder — é o que impede o lembrete de virar insistência: um por
     abandono, não um a cada meia hora. */
  retomadaAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(60)
  pass      String   @db.VarChar(255) // hash bcrypt da senha
  // "admin"      = acesso total ao painel (Inêz e equipe administrativa)
  // "instrutora" = só a Agenda, e só para olhar: não cria, não edita, não apaga
  role      String   @default("admin") @db.VarChar(20)
  nome      String?  @db.VarChar(120) // nome de exibição (ex.: "Francielle Vitorino")
  createdAt DateTime @default(now())
}

/* Feriado cadastrado na mão pela Inêz (Configurações).
   Os feriados NACIONAIS não moram aqui: são calculados em src/feriados.js, os
   móveis inclusive. Esta tabela é para o que só a escola sabe — o feriado
   municipal de Ipatinga, o de Timóteo, um recesso, uma emenda de fim de ano —
   e para o contrário disso: `remove` = neste feriado nacional a escola ABRE. */
model Holiday {
  id        Int      @id @default(autoincrement())
  date      String   @unique @db.VarChar(10) // 'YYYY-MM-DD'
  nome      String   @default("Feriado") @db.VarChar(120)
  remove    Boolean  @default(false) // true = desmarca um feriado nacional
  createdAt DateTime @default(now())
}

/* Exceção decidida na própria agenda. O calendário automático continua sendo
   a fonte do nome do feriado; esta linha apenas registra que, naquela unidade,
   a ADMIN ligou "Terá aula". A chave composta impede Ipatinga de alterar
   Timóteo no mesmo dia. */
model HolidayOverride {
  id         Int      @id @default(autoincrement())
  date       String   @db.VarChar(10)
  unit       String   @db.VarChar(100)
  hasClasses Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([date, unit])
  @@index([date])
}

model Settings {
  id               Int    @id @default(1)
  valorPadrao      Float  @default(80)
  capacidadePadrao Int    @default(4)
  units            String @default("[\"Ipatinga\",\"Timóteo\"]") @db.VarChar(1000) // JSON
  profs            String @default("[\"Inêz\",\"Equipe FQC\"]") @db.VarChar(1000) // JSON
  horarioFunc      String @default("Seg a Sáb, 09h às 17h") @db.VarChar(1000) // texto legado OU JSON com horário por dia da semana
  horarioUnidades  String? @db.Text // JSON: { "Ipatinga": ["HH:MM-HH:MM",...], ... } — horário por unidade cadastrada
  pixKey           String @default("") @db.VarChar(255)
  pixName          String @default("") @db.VarChar(255)
  mensalidadeValor Float  @default(0)   // legado: usado só quando o aluno não tem plano 1x/2x
  vencimentoDia    Int    @default(10)  // dia de vencimento padrão (1-28)
  // ----- travas de cobrança (desligadas até a Inêz confirmar) -----
  // true = mensalidade vencida bloqueia ganhar/usar crédito de reposição
  travaAtraso      Boolean @default(false)
  // true = o Pix da mensalidade expira no vencimento e precisa ser reemitido
  pixExpira        Boolean @default(false)
  // true = mensalidade vencida passa a cobrar multa e juros (valores fixos em regrasAula.js)
  cobrarEncargos   Boolean @default(false)
  // true = o servidor manda sozinho as mensagens que a ESCOLA inicia no WhatsApp:
  // lembrete e cobrança de mensalidade, lembrete da véspera da aula, e a retomada
  // de conversa parada. Desligada, o bot só responde quem falar com ele.
  waAvisosAuto     Boolean @default(false)
  // true = o servidor gera sozinho as mensalidades do mês (rodada de hora em hora).
  // Desligada, só nascem mensalidades pelo botão "gerar" do painel — é o que
  // permite combinar o valor de cada mês antes de a cobrança existir.
  geracaoAuto      Boolean @default(false)
  // ----- tabela de preços -----
  valorPlano1x     Float  @default(120) // mensalidade de 1x por semana (4 aulas/mês)
  valorPlano2x     Float  @default(200) // mensalidade de 2x por semana (8 aulas/mês)
  valorAvulsa      Float  @default(40)  // aula extra avulsa
  duracaoAulaMin   Int    @default(120) // duração da aula em minutos
  /* Taxa de matrícula: cobrada UMA vez, junto da 1ª mensalidade da aluna nova.
     Saiu em 28/08/2026 (diluída na mensalidade) e voltou em 01/09/2026, por
     decisão do Vitor — agora como parcela separada e visível, tanto no site
     quanto na conversa do WhatsApp.

     É por isso que ela é campo, e não número no código: já mudou duas vezes em
     cinco dias. Zerar aqui DESLIGA a taxa — o primeiro pagamento volta a ser só
     a mensalidade, sem precisar de deploy.

     Ao contrário da mensalidade, a taxa NÃO é devolvida se a aluna desistir
     depois da 1ª aula (Vitor, 01/09/2026). Quem guarda quanto foi cobrado de
     cada aluna é Booking.taxaMatricula — mudar este valor não reescreve o
     passado. */
  taxaMatricula    Float  @default(20)
}
