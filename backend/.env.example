# Copie este arquivo para .env e ajuste com os dados do seu MySQL local.
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://root:@localhost:3306/fios_que_curam"
PORT=4000

# ---------- API Pix do Sicredi (recebimentos) ----------
# Credenciais e certificado saem do portal https://developers.sicredi.com.br
# Enquanto estas variáveis não estiverem completas, o sistema segue funcionando
# normalmente — só não gera Pix (a cobrança fica registrada sem código).

# "prod" usa api-pix.sicredi.com.br. Para homologação, use SICREDI_HOST com o
# host que o Sicredi informar na liberação do acesso.
SICREDI_ENV=prod
# SICREDI_HOST=api-pix-h.sicredi.com.br

SICREDI_CLIENT_ID=
SICREDI_CLIENT_SECRET=

# Chave Pix da conta recebedora (a mesma conta dona do certificado).
SICREDI_PIX_KEY=

# Certificado mTLS em PEM. Se o Sicredi entregar em DER, converta antes:
#   openssl x509 -inform der -in cert.cer -out certificate.pem
# A chave privada não pode ter senha.
SICREDI_CERT_PATH=./certs/certificate.pem
SICREDI_KEY_PATH=./certs/private-key.key

# URL pública que recebe o aviso de Pix pago. Cadastre uma vez com:
#   node --env-file=.env scripts/registrar-webhook-sicredi.mjs --gravar
# O Sicredi notifica acrescentando "/pix" ao final desta URL.
SICREDI_WEBHOOK_URL=https://fiosquecuram.com.br/api/sicredi/webhook
